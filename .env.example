# Optional SEC filings enrichment (not required for price/backtest paths)
SEC_API_KEY=

# Market data
MARKET_DATA_PROVIDER=yfinance
MARKET_DATA_FALLBACKS=stooq

# Stooq (required by Stooq as of 2026 for reliable CSV access)
STOOQ_API_KEY=

# Polygon.io / Massive.com (same keys work on both hosts)
POLYGON_API_KEY=
MASSIVE_API_KEY=

# Databento
DATABENTO_API_KEY=
DATABENTO_DATASET=EQUS.SUMMARY
